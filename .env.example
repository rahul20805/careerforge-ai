# =================================================================
# CareerForge AI - Environment Configuration
# =================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CareerForge AI"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-must-be-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database & Storage ---
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/careerforge
# Default fallback to SQLite for local development:
DATABASE_URL="sqlite+aiosqlite:///./careerforge.db"
SYNC_DATABASE_URL="sqlite:///./careerforge.db"

# Storage
STORAGE_PROVIDER="local"
STORAGE_DIR="./uploads"
GENERATED_DOCS_DIR="./generated_docs"

# --- AI Provider Configuration ---
# Options: "gemini", "openai", "fallback"
AI_PROVIDER="gemini"
AI_CLASSIFICATION_MODEL="gemini-1.5-flash"
AI_EXTRACTION_MODEL="gemini-1.5-flash"
AI_DOCUMENT_MODEL="gemini-1.5-pro"
AI_EMBEDDING_MODEL="text-embedding-004"

# External API Keys (Optional - gracefully degrades with truth/heuristic fallback if not provided)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
HUNTER_API_KEY=""

# --- Scheduler & Limits ---
SCHEDULED_SEARCH_INTERVAL_HOURS=24
DEADLINE_ALERT_DAYS=[7, 3, 1, 0]
MAX_DAILY_OUTREACH_EMAILS=20

# --- Frontend URL ---
NEXT_PUBLIC_API_URL="http://localhost:8000"
